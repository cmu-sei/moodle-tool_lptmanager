<?xml version="1.0" encoding="UTF-8" ?>
<XMLDB PATH="admin/tool/lptmanager/db" VERSION="20261020" COMMENT="XMLDB file for Moodle admin/tool/lptmanager"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:noNamespaceSchemaLocation="../../../../lib/xmldb/xmldb.xsd"
>
  <TABLES>
    <TABLE NAME="tool_lptmanager_lrs_sync" COMMENT="Tracks xAPI competency assertion statements synced from SQL LRS to avoid duplicate processing">
      <FIELDS>
        <FIELD NAME="id" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="true"/>
        <FIELD NAME="statementid" TYPE="char" LENGTH="36" NOTNULL="true" SEQUENCE="false" COMMENT="xAPI statement UUID"/>
        <FIELD NAME="userid" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="false" COMMENT="Moodle user ID"/>
        <FIELD NAME="competencyid" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="false" COMMENT="Moodle competency ID"/>
        <FIELD NAME="planid" TYPE="int" LENGTH="10" NOTNULL="false" SEQUENCE="false" COMMENT="Moodle learning plan ID"/>
        <FIELD NAME="verb" TYPE="char" LENGTH="255" NOTNULL="true" SEQUENCE="false" COMMENT="xAPI verb IRI (asserted or validated)"/>
        <FIELD NAME="exerciseid" TYPE="char" LENGTH="36" NOTNULL="false" SEQUENCE="false" COMMENT="crucible:exerciseId from the statement"/>
        <FIELD NAME="runid" TYPE="char" LENGTH="36" NOTNULL="false" SEQUENCE="false" COMMENT="crucible:runId from the statement"/>
        <FIELD NAME="timecreated" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="false" COMMENT="When this sync record was created"/>
      </FIELDS>
      <KEYS>
        <KEY NAME="primary" TYPE="primary" FIELDS="id"/>
        <KEY NAME="userid" TYPE="foreign" FIELDS="userid" REFTABLE="user" REFFIELDS="id"/>
        <KEY NAME="competencyid" TYPE="foreign" FIELDS="competencyid" REFTABLE="competency" REFFIELDS="id"/>
      </KEYS>
      <INDEXES>
        <INDEX NAME="statementid" UNIQUE="true" FIELDS="statementid"/>
        <INDEX NAME="userid_competencyid" UNIQUE="false" FIELDS="userid, competencyid"/>
      </INDEXES>
    </TABLE>
    <TABLE NAME="tool_lptmanager_crosswalk" COMMENT="Mappings from competencies in one framework to competencies in another, used to move links to a new framework version">
      <FIELDS>
        <FIELD NAME="id" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="true"/>
        <FIELD NAME="sourceframework" TYPE="char" LENGTH="100" NOTNULL="true" SEQUENCE="false" COMMENT="ID number of the framework being mapped from"/>
        <FIELD NAME="sourceidnumber" TYPE="char" LENGTH="100" NOTNULL="true" SEQUENCE="false" COMMENT="ID number of the competency being mapped from"/>
        <FIELD NAME="targetframework" TYPE="char" LENGTH="100" NOTNULL="true" SEQUENCE="false" COMMENT="ID number of the framework being mapped to"/>
        <FIELD NAME="targetidnumber" TYPE="char" LENGTH="100" NOTNULL="false" SEQUENCE="false" COMMENT="ID number of the competency being mapped to; empty for deprecated"/>
        <FIELD NAME="relation" TYPE="char" LENGTH="20" NOTNULL="true" SEQUENCE="false" COMMENT="SKOS mapping relation, or deprecated"/>
        <FIELD NAME="provenance" TYPE="char" LENGTH="100" NOTNULL="false" SEQUENCE="false" COMMENT="Where the mapping came from"/>
        <FIELD NAME="confidence" TYPE="number" LENGTH="3" NOTNULL="false" SEQUENCE="false" DECIMALS="2" COMMENT="0 to 1, for derived mappings"/>
        <FIELD NAME="status" TYPE="char" LENGTH="10" NOTNULL="true" SEQUENCE="false" COMMENT="proposed, approved or rejected"/>
        <FIELD NAME="note" TYPE="text" NOTNULL="false" SEQUENCE="false"/>
        <FIELD NAME="reviewedby" TYPE="int" LENGTH="10" NOTNULL="false" SEQUENCE="false" COMMENT="User who last approved or rejected the mapping"/>
        <FIELD NAME="timereviewed" TYPE="int" LENGTH="10" NOTNULL="false" SEQUENCE="false"/>
        <FIELD NAME="timecreated" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="false"/>
        <FIELD NAME="timemodified" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="false"/>
      </FIELDS>
      <KEYS>
        <KEY NAME="primary" TYPE="primary" FIELDS="id"/>
        <KEY NAME="reviewedby" TYPE="foreign" FIELDS="reviewedby" REFTABLE="user" REFFIELDS="id"/>
      </KEYS>
      <INDEXES>
        <INDEX NAME="source" UNIQUE="false" FIELDS="sourceframework, targetframework, sourceidnumber"/>
      </INDEXES>
    </TABLE>
  </TABLES>
</XMLDB>
